# ==========================================
# 高考数学一体化 Agent 环境配置示例
# 复制本文件为 .env 后按需修改
# ==========================================

# Ollama 服务地址（本地默认即可）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 主模型：负责解题、推理、生成标准答案（需先在 Ollama 中拉取）
LLM_MODEL=deepseek-r1:14b

# 快速模型：负责拆题等轻量环节，可显著提升功能1速度（需在 Ollama 中拉取）
FAST_MODEL=qwen2.5:7b

# 单次推理超时时间（秒）
TIMEOUT=800

# 最大输出 token 数（含推理模型的思考 token）
MAX_TOKENS=6144

# Ollama 上下文窗口：不设时默认 4096，长题/知识库提示词会被静默截断
NUM_CTX=8192

# 解题图收敛控制：单题最多几轮工具调用 / LangGraph 步数上限
# 模型"反复验算停不下来"导致 Recursion limit 报错时，调大 RECURSION_LIMIT 或调小 MAX_TOOL_ROUNDS
MAX_TOOL_ROUNDS=3
RECURSION_LIMIT=30

# 复核开关：on=解题后再复核一遍（保证标准答案质量，耗时约翻倍），off=跳过复核，速度更快
ENABLE_CHECKER=on

# ==========================================
# 数学模型配置（计算密集型题目更精准）
# ==========================================
# MATH_PROVIDER: ollama（本地模型，免费）/ siliconflow（硅基流动）/ deepseek（DeepSeek 官方）
MATH_PROVIDER=ollama

# DeepSeek 官方 API Key（仅当 MATH_PROVIDER=deepseek 时需要）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 硅基流动 API Key（仅当 MATH_PROVIDER=siliconflow 时需要）
# 注册地址：https://siliconflow.cn ，在「API密钥」页面获取
SILICONFLOW_API_KEY=

# 数学模型名称：
#   ollama 模式：qwen2.5:14b（需先 ollama pull qwen2.5:14b）
#   deepseek 模式：deepseek-v4-pro（旗舰，带推理）/ deepseek-flash（快速版）
#   siliconflow 模式：deepseek-ai/DeepSeek-V3（推荐，数学计算极强）
#                     或 Qwen/Qwen2.5-72B-Instruct
MATH_MODEL=qwen2.5:14b

# 费用估算单价（元 / 百万 token），仅用于本地用量统计展示
API_PRICE_IN=2
API_PRICE_OUT=8

# 数学模型单次输出 token 上限（云端模型）
MATH_MAX_TOKENS=3072

# 每日云端预算上限（元，0=不限制）：超限后拒绝新的云端解题并给出提示
DAILY_BUDGET_CNY=3

# 云端调用失败（余额不足/断网/超时/Key 失效）时自动降级本地模型继续作答
FALLBACK_TO_LOCAL=on
