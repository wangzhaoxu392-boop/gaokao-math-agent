# ==========================================
# 高考数学一体化 Agent 环境配置示例
# 复制本文件为 .env 后按需修改
# ==========================================

# Ollama 服务地址（本地默认即可）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 主模型：负责解题、推理、生成标准答案（需先在 Ollama 中拉取）
LLM_MODEL=deepseek-r1:14b

# 快速模型：负责拆题等轻量环节，可显著提升功能1速度（需在 Ollama 中拉取）
FAST_MODEL=qwen2.5:7b

# 单次推理超时时间（秒）
TIMEOUT=800

# 最大输出 token 数
MAX_TOKENS=6144
